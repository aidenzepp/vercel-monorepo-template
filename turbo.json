{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "packages/typescript-config/**"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "OAUTH_PROXY_SECRET"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "env": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "OAUTH_PROXY_SECRET"
      ],
      "persistent": true
    }
  }
}
