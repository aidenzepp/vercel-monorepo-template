{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "packages/typescript-config/**"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "BETTER_AUTH_API_KEY",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "OAUTH_PROXY_SECRET",
        "BLOB_READ_WRITE_TOKEN",
        "BLOB_STORE_ID",
        "BLOB_WEBHOOK_PUBLIC_KEY",
        "RESEND_API_KEY",
        "RESEND_EMAIL_DOMAIN",
        "VERCEL_OIDC_TOKEN",
        "VERCEL_BRANCH_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "env": [
        "BETTER_AUTH_API_KEY",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "OAUTH_PROXY_SECRET",
        "BLOB_READ_WRITE_TOKEN",
        "BLOB_STORE_ID",
        "BLOB_WEBHOOK_PUBLIC_KEY",
        "RESEND_API_KEY",
        "RESEND_EMAIL_DOMAIN",
        "VERCEL_OIDC_TOKEN",
        "VERCEL_BRANCH_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL"
      ],
      "persistent": true
    }
  }
}
