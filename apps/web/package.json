{
  "name": "@workspace/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:vercel": "bun run build",
    "auth:schema": "auth generate --config ./db/schema/auth-config.ts --output ./db/schema/auth.ts --yes && bun --cwd ../.. oxfmt --config oxfmt.config.ts --write apps/web/db/schema/auth.ts",
    "db:check": "bun --env-file=../../.env.local drizzle-kit check",
    "db:generate": "bun --env-file=../../.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env.local drizzle-kit migrate",
    "db:studio": "bun --env-file=../../.env.local drizzle-kit studio",
    "start": "next start",
    "format": "bun --cwd ../.. oxfmt --config oxfmt.config.ts --write apps/web",
    "lint": "bun --cwd ../.. oxlint --config oxlint.config.ts apps/web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.2",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@better-auth/infra": "^0.4.5",
    "@better-auth/passkey": "1.7.2",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.6",
    "@vercel/speed-insights": "^1.3.1",
    "@workspace/better-auth": "workspace:*",
    "@workspace/t3-env": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:*",
    "better-auth": "^1.7.2",
    "cuelume": "0.2.2",
    "drizzle-orm": "^0.45.2",
    "files-sdk": "2.4.1",
    "lucide-react": "^1.44.0",
    "next": "latest",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.87.0",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/typescript-config": "workspace:*",
    "auth": "^1.7.2",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.11.6",
    "typescript": "^7.0.2"
  }
}
