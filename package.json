{
  "name": "templ8",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "tsc --noEmit && turbo typecheck",
    "check": "ultracite check --type-aware",
    "fix": "ultracite fix --type-aware"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.3",
    "@shadcn/lint": "^0.1.0",
    "@types/bun": "latest",
    "@workspace/typescript-config": "workspace:*",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.9.18",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.4",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "files-sdk@2.4.1": "patches/files-sdk@2.4.1.patch"
  }
