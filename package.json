{
  "name": "vercel-monorepo-template",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "check": "ultracite check --type-aware",
    "fix": "ultracite fix --type-aware"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@workspace/typescript-config": "workspace:*",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^0.24.0",
    "turbo": "^2.9.18",
    "typescript": "^5.9.3",
    "ultracite": "^7.10.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
